APP_ENV=development
APP_NAME=Codekop Go MVC
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Jakarta
HTTP_ADDR=:8080

# Leave DB_NAME empty to run the stateless sample API without a database.
# Supported values: mysql (MariaDB/MySQL) or postgres (PostgreSQL).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional MariaDB/MySQL Unix socket, e.g. /tmp/mysql.sock. Leave empty for TCP.
DB_SOCKET=
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_SSLMODE=disable
